{"nodes": [{"id": "docs_launcher", "label": "Launcher (docs/LAUNCHER.md)", "file_type": "document", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_providers_never_render_rule", "label": "Providers Never Render, UI Never Searches, Nothing Else Ranks", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each of provider, UI, controller, and keyboard mapper can change without reading the others; a new provider is a subclass plus four registration lines."}, {"id": "docs_launcher_coupling_surface", "label": "LauncherManager Tessera Coupling Object (context.tessera)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Coupling to the rest of Tessera", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_search_pipeline", "label": "Launcher Search Pipeline (parseQuery -> query -> rank -> sections)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "The search pipeline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recomputed from scratch every keystroke; full pass under a millisecond at this scale."}, {"id": "docs_launcher_fuzzy_matching_tiers", "label": "Fuzzy Matching Non-Overlapping Tiers", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Matching", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact > prefix > word prefix > acronym > substring > subsequence > typo (bounded Damerau-Levenshtein) so weaker kinds never outrank stronger; multi-term score 75% average + 25% worst."}, {"id": "docs_launcher_ranking_formula", "label": "Ranking Formula (provider weight + favorite + frecency + context boost)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Ranking", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boosts small relative to match score so they reorder near-equal matches but never float a poor match above a good one; frecency two-week half-life, saturating."}, {"id": "docs_launcher_open_windows_priority", "label": "Open Windows Priority Section", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": "Section order", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switching to something already open is the most common request; windows filled first and sorted first so result cap cannot break the promise."}, {"id": "docs_launcher_scope_bar_chips", "label": "Scope Bar Filter Chips", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Filtering: the chips", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts describe the unfiltered world; All passed separately not summed (fixed bug); chips follow SECTION_ORDER for muscle memory; Ctrl+Tab wraps; scope resets every open; empty-query filter browses the section."}, {"id": "docs_launcher_slash_palette", "label": "Slash Palette (filters and slash commands)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "The slash palette", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A regular provider answering '/' prefix; /search and /chat are URL templates so services changing parameters is a settings edit; entries are keepOpen and ephemeral."}, {"id": "docs_launcher_search_provider_contract", "label": "SearchProvider Interface Contract", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Providers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "defaultResults (curated home) vs browseResults (everything for a filter); async Promise from query() merged with generation token staleness check."}, {"id": "docs_launcher_action_catalogue", "label": "Action Catalogue (System / Shell / Tessera actions)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "The action catalogue", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System actions delegated to SystemActions for lockdown/inhibitor parity; Hibernate uses logind D-Bus; unavailable actions are absent rather than greyed."}, {"id": "docs_launcher_workspace_grammar", "label": "Workspace Argument Grammar (workspace N / move <app> N)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "The action catalogue", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires literal number so ordinary searches are never swallowed; app match must be >= 0.6; reaches workspaces 10+ unaddressable by Super+1..9."}, {"id": "docs_launcher_keyboard_design", "label": "Launcher Keyboard Bindings Design", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Keyboard", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Home/End navigate list; Tab cycles sections; Left/Right never intercepted so chips moved to Ctrl+Tab; accelerator registered with POPUP action mode so second press closes."}, {"id": "docs_launcher_hover_motion_gate", "label": "Hover Selection Pointer-Motion Gate", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Mouse", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hover only selects if pointer coordinates changed since last evaluation/rebuild, so list rebuilds and opening under a resting cursor do not steal keyboard selection."}, {"id": "docs_launcher_popup_behavior", "label": "Launcher Popup Behavior (modal grab, close-then-activate)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "The popup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Activation pops the modal grab before running the action so opened dialogs are not fighting the grab; partial grab aborts opening; settings gear hands page via prefs-initial-page GSettings key."}, {"id": "docs_launcher_theme_system", "label": "Launcher Theme System (theme.js inline colors)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Theme system", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stylesheet.css carries structure only; every setting-driven color resolved inline to avoid flash-of-wrong-theme; reuses accentColor.js Gio.Settings."}, {"id": "docs_launcher_placement", "label": "Launcher Placement (work area, 16% anchor, offset clamp)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Placement", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_security_privacy", "label": "Launcher Security and Privacy (no shell, no eval, opt-in clipboard)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Security and privacy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands parsed by GLib.shell_parse_argv and spawned without a shell; calculator is a recursive-descent parser; clipboard skips password-manager mimetypes and locked sessions; favorites store keys not content."}, {"id": "docs_launcher_performance_targets", "label": "Launcher Performance Targets (30ms open, 10ms search)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Performance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actor tree built once and kept hidden; caches warmed on low-priority timeout; pooled rows; search delay defaults 0 because debounce only adds latency to a synchronous pipeline."}, {"id": "docs_launcher_lifecycle", "label": "Launcher Lifecycle (null-field footprint when off)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_future_work", "label": "Launcher Future Work (providers, sessions, sub-queries)", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": "Future work", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_launcher", "target": "docs_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LAUNCHER.md", "source_location": "Theme system", "weight": 1.0}, {"source": "docs_launcher", "target": "docs_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LAUNCHER.md", "source_location": "Testing", "weight": 1.0}, {"source": "docs_architecture_poll_loop_recompute", "target": "docs_launcher_search_pipeline", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LAUNCHER.md", "source_location": "The search pipeline", "weight": 1.0}, {"source": "docs_launcher_providers_never_render_rule", "target": "docs_launcher_search_provider_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LAUNCHER.md", "source_location": "Architecture", "weight": 1.0}, {"source": "docs_launcher_search_pipeline", "target": "docs_launcher_fuzzy_matching_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LAUNCHER.md", "source_location": "The search pipeline", "weight": 1.0}, {"source": "docs_launcher_search_pipeline", "target": "docs_launcher_ranking_formula"