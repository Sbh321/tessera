{"nodes": [{"id": "docs_architecture", "label": "Architecture (docs/ARCHITECTURE.md)", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_no_monkey_patching_principle", "label": "No Monkey-Patching / Work With GNOME's Model", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Goals that shaped the design", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every switch/move/resize goes through public Mutter/Shell APIs so behavior GNOME owns (focus, animations, workspace lifetime, floating) stays GNOME's; no prototype overrides anywhere."}, {"id": "docs_architecture_clean_disable_principle", "label": "disable() Restores Stock State", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Goals that shaped the design", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No leaked signals, actors, keybindings, or residual schema changes after disable()."}, {"id": "docs_architecture_extension_js_composition_root", "label": "extension.js Composition Root (No Logic)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Module map", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modules are mutually unaware; only extension.js wires them, so a bug not in lib/ is not in this codebase."}, {"id": "docs_architecture_window_mover", "label": "WindowMover (stateless composition)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Window movement", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin composition of Main.wm.actionMoveWindow/insertWorkspace and Meta.Window maximize; holds no state, signals, or timers so nothing to clean up. insertWorkspace chosen over reorder_workspace because GNOME's path already handles transients/override-redirect/sticky."}, {"id": "docs_architecture_keep_workspace_alive_deferral", "label": "Emptied Source Workspace Keep-Alive Deferral", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Window movement edge cases", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_moveFollowing calls Main.wm.keepWorkspaceAlive(source, ~400ms) so WorkspaceTracker culls the emptied source after the follow animation, avoiding mid-slide reindexing that jerked the animation and desynced the active square."}, {"id": "docs_architecture_new_window_workspace_placement", "label": "One-App-Per-Workspace Placement", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "New-window placement", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides only whether a window qualifies and delegates the move to WindowMover.moveToNewWorkspace; never manufactures an empty workspace when one exists; deferred one idle turn because transient/skip-taskbar state is not yet declared at window-created."}, {"id": "docs_architecture_is_content_window_predicate", "label": "_isContentWindow Shared Occupied/Relocatable Predicate", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "New-window placement", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Occupied and relocatable must use the same predicate; when they differed a splash screen or helper made a visibly empty workspace count as occupied."}, {"id": "docs_architecture_keybind_fullscreen", "label": "Keybind Fullscreen (FullscreenManager)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Keybind fullscreen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only tracks windows fullscreened through it (_fullscreened Set) so exit triggers never interrupt an app's own video fullscreen; Escape grab is scoped by focus, an accepted trade-off vs apps needing Escape."}, {"id": "docs_architecture_tiling_subsystem", "label": "Tiling Subsystem (lib/tiling/)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_reconciled_layout_tree", "label": "Reconciled LayoutTree (Dwindle Split Tree)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Focus-aware insertion and sibling reclamation are structural and cannot be expressed by a stateless count-based strategy; the tree is never trusted and is reconciled against workspace.list_windows() every pass (idempotent reconcile-on-read)."}, {"id": "docs_architecture_focus_aware_insertion", "label": "Focus-Aware Window Insertion Anchor", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchor captured synchronously at window-created since focus moves before the debounced pass; falls back to dwindle-spiral tail reproducing old stateless layout bit-for-bit."}, {"id": "docs_architecture_two_tier_membership", "label": "Two-Tier Membership (isLayoutMember / isTileable)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity-level membership keeps the tree leaf while transient states (minimized, maximized) temporarily remove a rectangle, so restore returns the window to its exact slot."}, {"id": "docs_architecture_integer_layout_math", "label": "Pure Integer Layout Math", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split axis chosen at compute time from aspect ratio; second child is exact remainder so no drift/overlap/gap; pure engine is unit-testable outside the shell."}, {"id": "docs_architecture_debounced_relayout_pipeline", "label": "Debounced Event-to-Relayout Pipeline", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dirty workspaces accumulate in a Set flushed by one GLib.idle_add; loop-proof because windows only move when frame rect differs from target."}, {"id": "docs_architecture_post_creation_settling_watch", "label": "Post-Creation Settling Watch (_watchSettling)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apps like Chromium/Electron finalize size after window-created, causing vanished right/bottom gaps; a 2.5s grace watch on size/position-changed re-queues layout, scoped so it never fights user drags."}, {"id": "docs_architecture_buckets", "label": "Layout Buckets (workspace x monitor)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_exclusive_occupants", "label": "Exclusive Occupants Suspend Bucket", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fullscreen or user-maximized window suspends reflow and hides tab bar, preventing tiles from zooming into the vacated slot; tiler never force-exits fullscreen to avoid interrupting video."}, {"id": "docs_architecture_stacked_mode", "label": "Stacked (Tabbed) Layout Mode", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group posture requiring at least two layout members; auto-reverts to tiled in _flush() when members drop below two; tab clicks just activate windows, no local selection state to drift."}, {"id": "docs_architecture_module_scope_state_survives_lock", "label": "Module-Scope State Survives Lock Disable Cycle", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES modules stay cached for the shell process, so stackedWorkspaces and floatingWindows Sets at module scope survive disable/enable around screen lock, while trees/anchors/signals rebuild fresh."}, {"id": "docs_architecture_tab_bar_no_trackfullscreen", "label": "Tab Bar Not trackFullscreen Chrome (Manager Owns Visibility)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "layout.js _updateActorVisibility force-writes visible on trackFullscreen actors, overriding hide() during gesture-opened overview and workspace-switch restacks."}, {"id": "docs_architecture_gesture_hide_as_state", "label": "Tab Bar Gesture Hide as State + Swipe Slide", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A one-shot hide is undone by mid-drag relayouts; a flag raised on swipe begin and dropped on workspace-switched or cancelled end; _attachSwipeTabBars parents throwaway bars into WorkspaceGroups so they slide."}, {"id": "docs_architecture_tab_bar_window_layer_zorder", "label": "Tab Bar Restacked Into Window Layer", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "addChrome places actors above panel, lock shield, and notifications; set_child_above_sibling(bar, global.window_group) makes it behave as workspace content."}, {"id": "docs_architecture_per_window_floating", "label": "Per-Window Floating as Membership Override", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Tiling subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floating is orthogonal to tiled/stacked; injected floatingWindows Set keeps windowFilter pure; isExclusiveOccupant deliberately ignores the float set so maximized floating windows still hide the tab bar."}, {"id": "docs_architecture_focus_border", "label": "Focus Border (FocusBorderManager)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Focus border", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent of tiling; tracks exactly one focused window; drawn outside the frame non-reactive; hides on switch-workspace and swipe begin because chrome does not slide with workspace animation."}, {"id": "docs_architecture_panel_auto_hide", "label": "Panel Auto-Hide (PanelAutoHideManager)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Panel auto-hide", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slides via panelBox.translation_y (GNOME's own mechanism), releases strut via untrackChrome/trackChrome, never touches visible; one 100ms poll loop re-derives reveal state instead of barriers or hot-edge actors."}, {"id": "docs_architecture_panel_opacity", "label": "Panel Opacity Style Composition", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Panel auto-hide", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rgba background composed into Main.panel.style and re-asserted on notify::style because overview.js clobbers it; pins transition-duration 0ms to avoid a 250ms black flash."}, {"id": "docs_architecture_poll_loop_recompute", "label": "Recompute-From-Ground-Truth Posture", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Panel auto-hide / Tiling / Launcher", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-derive state from scratch each pass/tick/keystroke so missed events self-correct and nothing goes stale."}, {"id": "docs_architecture_launcher_subsystem", "label": "Launcher Subsystem (architecture summary)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Launcher subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_captured_target_window", "label": "Captured Target Window for Launcher Actions", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Launcher subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modal grab means live focus at activation is unreliable; popup captures focus_window on open and passes it via optional trailing window parameters on WindowMover/TilingManager/FullscreenManager."}, {"id": "docs_architecture_conditional_input_source_conflict", "label": "Conditional Super+Space Input-Source Conflict Clearing", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "Launcher subsystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "switch-input-source keys cleared only when the launcher is enabled and its accelerator actually collides (_inputSourceConflicts), so users not using the launcher keep layout switching."}, {"id": "docs_architecture_keybinding_save_clear_restore", "label": "Keybinding Save/Clear/Watch/Restore Lifecycle", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "The four places this extension reaches outside its own schema", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutter dispatches one action per accelerator; exact prior values saved in memory and restored; REASSERT_DELAY_MS re-grab and persistent watches defend against GNOME's separate Gio.Settings async race; dock hot-keys=false removes the second owner at source."}, {"id": "docs_architecture_four_external_reaches", "label": "Four Places Reaching Outside Own Schema", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "The four places this extension reaches outside its own schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_native_indicator_hider", "label": "Native Activities Button Hider", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "The four places #2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hides Main.panel.statusArea.activities.container re-asserted on sessionMode updated, plus CSS .workspace-dot collapse as defensive layer; fails silently on mismatch."}, {"id": "docs_architecture_accent_color_lookup", "label": "Yaru Accent Color Lookup via gtk-theme", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "The four places #3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_swipe_tracker_private_reach", "label": "Swipe Tracker Private Field Reach (_workspaceAnimation._swipeTracker)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "The four places #4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one genuine private-API reach; guarded by optional chaining, typeof check and try/catch; one surface with three fail-safe readers (gesture tracker, focus border, tiling manager)."}, {"id": "docs_architecture_gesture_progress_tracker", "label": "GestureProgressTracker Live Preview", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "The four places #4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps progress as absolute fractional workspace index with clamp(round(progress)); verification event-driven on workspace-switched; safety valve pauses after CONSECUTIVE_RESULTS_TO_TOGGLE misses and re-enables after the same number of hits."}, {"id": "docs_architecture_settings_to_rendering", "label": "Settings to Rendering Inline-Style Discipline", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Settings -> rendering", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active colors always resolved to explicit inline values, applied before toggling .active class, and stylesheet carries no active colors, eliminating stock-blue flashes through St transitions."}, {"id": "docs_architecture_panelmenu_button_no_menu", "label": "PanelMenu.Button With No Menu", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "Why PanelMenu.Button with no menu", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Squares always visible Hyprland-style; dontCreateMenu=true instead of GNOME workspace-indicator's dropdown fallback past 6 workspaces."}], "edges": [{"source": "docs_architecture", "target": "docs_gnome_notes", "relation": "references", "confidence": 