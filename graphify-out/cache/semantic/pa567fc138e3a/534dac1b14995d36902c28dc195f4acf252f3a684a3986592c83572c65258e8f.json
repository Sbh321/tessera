{"nodes": [{"id": "docs_launcher_launcher", "label": "Tessera Launcher Design", "file_type": "document", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_provider_controller_ui_separation", "label": "Provider Controller UI Separation", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Providers emit data without rendering, the UI draws ranked sections without searching, and the controller alone scores and orders results, making providers independently extensible."}, {"id": "docs_launcher_captured_target_window", "label": "Captured Target Window", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The popup captures focus when it opens because its modal grab makes live focus at activation time an unreliable representation of the user's original target."}, {"id": "docs_launcher_search_pipeline", "label": "Launcher Search Pipeline", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_non_overlapping_match_tiers", "label": "Non-Overlapping Match Tiers", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact, prefix, word, acronym, substring, subsequence, and typo score bands do not overlap, preventing weak matches from outranking stronger kinds of match."}, {"id": "docs_launcher_adaptive_ranking", "label": "Adaptive Launcher Ranking", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_open_windows_priority", "label": "Open Windows Priority", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open windows receive first claim on result capacity and sort first because switching to existing user-visible content is the launcher's most common task."}, {"id": "docs_launcher_scope_bar", "label": "Scope Bar Filtering", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_slash_palette", "label": "Slash Palette", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_search_provider_contract", "label": "Search Provider Contract", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_action_catalogue", "label": "Launcher Action Catalogue", "file_type": "concept", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_launcher_safe_command_execution", "label": "Shell-Free Command Execution", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands require an explicit prefix, are parsed into argv, and are spawned without an interpreter so shell separators and substitutions cannot execute."}, {"id": "docs_launcher_safe_calculator_parser", "label": "Eval-Free Calculator Parser", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arithmetic uses a tokenizer and recursive-descent grammar rather than eval, rejecting every character and construct outside the supported expression language."}, {"id": "docs_launcher_clipboard_privacy", "label": "Clipboard History Privacy", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clipboard history is opt-in, excludes password-manager offers and locked sessions, and keeps clipboard contents out of general ranking history."}, {"id": "docs_launcher_literal_theme_values", "label": "Literal Launcher Theme Values", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime theme values are resolved to concrete inline colors and dimensions so St transitions cannot leak incorrect class-based colors."}, {"id": "docs_launcher_blur_disabled_by_default", "label": "Blur Disabled by Default", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shell.BlurEffect paints the full rectangular allocation and cannot follow rounded corners, so disabling it preserves exact transparent corners and avoids the visible artifact."}, {"id": "docs_launcher_lazy_lifecycle", "label": "Lazy Launcher Lifecycle", "file_type": "rationale", "source_file": "docs/LAUNCHER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While disabled the launcher retains only settings watchers; enabling creates providers and UI, while disabling destroys providers, caches, timeouts, actors, and modal grabs."}, {"id": "docs_launcher_async_provider_seam", "label": "Asynchronous