{"nodes": [{"id": "docs_architecture_architecture", "label": "Tessera Architecture", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_isolated_module_composition", "label": "Isolated Module Composition", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each capability is isolated in its own module or subsystem, with extension.js limited to construction and teardown, so concerns can evolve independently."}, {"id": "docs_architecture_public_api_cooperation", "label": "Cooperate with GNOME Public APIs", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workspace switching, window movement, and resizing use GNOME's public APIs so focus, animations, dynamic workspace lifetime, and floating rules remain GNOME-owned."}, {"id": "docs_architecture_exact_disable_restoration", "label": "Exact Disable Restoration", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "disable() must leak no signals, actors, timers, or keybindings and must restore external schema values and shell state exactly."}, {"id": "docs_architecture_window_movement", "label": "Window Movement Architecture", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_new_window_placement", "label": "New-Window Workspace Placement", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_owned_fullscreen_state", "label": "Owned Fullscreen State", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fullscreen exit triggers affect only windows fullscreened through Tessera, preventing new-window and Escape handling from interrupting application-owned video or game fullscreen."}, {"id": "docs_architecture_reconciled_layout_tree", "label": "Reconciled Layout Tree", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A binary split tree preserves focus-aware insertion and sibling-local space recovery, while reconciliation against live workspace membership prevents structural state from becoming stale."}, {"id": "docs_architecture_focus_aware_insertion", "label": "Focus-Aware Insertion", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_two_tier_window_membership", "label": "Two-Tier Window Membership", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity-level layout membership is separated from transient tileability so minimized or maximized windows retain their tree slots and return to the exact prior position."}, {"id": "docs_architecture_integer_layout_geometry", "label": "Pure Integer Layout Geometry", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split geometry uses integer arithmetic and remainder assignment to avoid drift, overlap, and rounding gaps at any tree depth or fractional scale."}, {"id": "docs_architecture_workspace_monitor_buckets", "label": "Workspace-Monitor Layout Buckets", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_debounced_relayout_pipeline", "label": "Debounced Relayout Pipeline", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dirty workspaces accumulate into one idle flush so bursts of window and workspace events coalesce, while frame comparison makes geometry application converge without feedback loops."}, {"id": "docs_architecture_stacked_group_posture", "label": "Stacked Group Posture", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stacked mode requires at least two layout members and auto-exits below that count because a one-tab group is worse than a full-area tiled window."}, {"id": "docs_architecture_persistent_user_layout_choices", "label": "Persistent User Layout Choices", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stacked-workspace and floating-window sets live at module scope so user choices survive GNOME's lock-cycle disable and enable while transient trees and signals rebuild cleanly."}, {"id": "docs_architecture_tab_bar_visibility_ownership", "label": "Tab-Bar Visibility Ownership", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stack tab bars omit trackFullscreen because GNOME force-writes visibility for tracked chrome, conflicting with overview, gesture, maximize, and fullscreen visibility decisions owned by the tiling manager."}, {"id": "docs_architecture_workspace_chrome_layering", "label": "Workspace Chrome Layering", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tab bars are restacked directly above ordinary windows so panels, lock shields, overview UI, menus, and notifications naturally cover them."}, {"id": "docs_architecture_per_window_floating_override", "label": "Per-Window Floating Membership Override", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floating is orthogonal per-window state injected into the pure membership filter, not a third workspace layout mode."}, {"id": "docs_architecture_focus_border", "label": "Independent Focus Border", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_panel_auto_hide", "label": "Panel Auto-Hide Architecture", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_ground_truth_recomputation", "label": "Ground-Truth Recomputation", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layout, launcher results, and panel reveal state are repeatedly re-derived from authoritative live state so missed events and stale intermediate state self-correct."}, {"id": "docs_architecture_keybinding_override_lifecycle", "label": "Keybinding Override Lifecycle", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflicting key values are saved exactly, cleared, watched and reasserted while active, then restored exactly, including Ubuntu Dock's independent grabs."}, {"id": "docs_architecture_defensive_private_api_reach", "label": "Defensive Private API Reach", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The swipe-tracker private field is accessed through guards and exception handling so future incompatibility disables only optional gesture enhancements, never core correctness."}, {"id": "docs_architecture_explicit_inline_active_colors", "label": "Explicit Inline Active Colors", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active colors are always concrete inline values applied before class changes so St transitions cannot sample and flash a stale default blue."}], "edges": [{"source": "docs_architecture_isolated_module_composition", "target": "docs_architecture_architecture", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_public_api_cooperation", "target": "docs_architecture_architecture", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_exact_disable_restoration", "target": "docs_architecture_architecture", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi