{
  "manifest_version": 3,
  "name": "Tessera Companion",
  "version": "2.0.0",
  "description": "Connects this browser to the Tessera GNOME Shell extension on this computer: the Tessera launcher can show, search and switch to your tabs. Everything stays on your machine.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "favicon",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
